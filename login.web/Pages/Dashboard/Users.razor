@page "/dashboard/users"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Users</PageTitle>

<div class="users-page">
	<header class="users-heading">
		<div>
			<p class="users-kicker">COMMUNITY</p>
			<h1>Users</h1>
			<p class="users-intro">Players in the Game's Heaven community.</p>
		</div>
		@if (currentUsers.Count > 0)
		{
			<span class="users-count">@currentUsers.Count @(currentUsers.Count == 1 ? "user" : "users")</span>
		}
	</header>

	@if (!string.IsNullOrWhiteSpace(statusMessage))
	{
		<div class="users-error" role="alert">
			<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5m0 4h.01" /></svg>
			<span>@statusMessage</span>
		</div>
	}
	else if (currentUsers.Count == 0)
	{
		<div class="users-empty" role="status">
			<span class="empty-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24"><path d="M16 20v-1.5a4.5 4.5 0 0 0-4.5-4.5h-3A4.5 4.5 0 0 0 4 18.5V20z" /><circle cx="10" cy="7" r="3.5" /><path d="M16 11a3.5 3.5 0 1 0 0-7m1 9h.5a3.5 3.5 0 0 1 3.5 3.5V19" /></svg>
			</span>
			<h2>There are no users yet</h2>
			<p>When players join, they’ll appear here.</p>
		</div>
	}
	else
	{
		<section class="users-list" aria-label="Registered users">
			<div class="users-list-heading">
				<span>PLAYER</span>
				<span>USER ID</span>
				<span class="games-column-heading">GAMES</span>
			</div>

			@foreach (var user in currentUsers)
			{
				<button class="user-row" type="button" @onclick="() => GoToUser(user.Id)" @key="user.Id">
					<span class="user-identity">
						@if (!string.IsNullOrWhiteSpace(user.ProfilePicture))
						{
							<img class="user-avatar" src="@user.ProfilePicture" alt="" />
						}
						else
						{
							<span class="user-avatar user-avatar-placeholder" aria-hidden="true">U</span>
						}
						<span class="user-name">@user.UserName</span>
					</span>
					<span class="user-id">#@user.Id</span>
					<span class="user-games-count">@(user.Games?.Count ?? 0) @(user.Games?.Count == 1 ? "game" : "games")</span>
				</button>
			}
		</section>
	}
</div>

