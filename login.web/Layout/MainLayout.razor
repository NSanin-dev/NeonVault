@using Microsoft.AspNetCore.Authorization
@using login.web.MiddleWare
@inherits LayoutComponentBase
@inject AuthenticationStateProvider _authState
@inject NavigationManager NavManager

<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="/dashboard" aria-label="Game's Heaven home">
            <svg class="brand-mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M15 12a1 1 0 1 0 0 2 1 1 0 1 0 0-2m2-2a1 1 0 1 0 0 2 1 1 0 1 0 0-2m-7-1H8v2H6v2h2v2h2v-2h2v-2h-2z"></path>
                <path d="M15 5H9c-3.85 0-6.99 3.13-7 6.99v.04C2.01 15.88 5.15 19 9 19h6c3.85 0 6.99-3.13 7-6.97V12c-.01-3.87-3.15-7-7-7m0 12H9c-2.75 0-5-2.24-5-4.99C4 9.25 6.25 7 9 7h6c2.75 0 5 2.25 5 5.01 0 2.75-2.25 4.99-5 4.99"></path>
            </svg>
            <span>Game's <strong>Heaven</strong></span>
        </a>

        <div class="profile-menu-container">
            <button class="profile-summary" type="button" @onclick="ToggleMenu" aria-label="Profile menu" aria-haspopup="menu" aria-expanded="@isActive" aria-controls="profile-menu">
                @if (!string.IsNullOrWhiteSpace(profilePicture))
                {
                    <img src="@profilePicture" alt="" class="profile-avatar" />
                }
                else
                {
                    <span class="profile-avatar profile-avatar-placeholder" aria-hidden="true">U</span>
                }
                <span class="profile-copy">
                    <span class="profile-caption">PLAYER PROFILE</span>
                    <span class="profile-name">@userName</span>
                </span>
                <span class="profile-chevron @(isActive ? "is-open" : null)" aria-hidden="true"></span>
            </button>

            @if (isActive)
            {
                <div class="profile-dropdown" id="profile-menu" role="menu" aria-label="Profile options">
                    <p class="dropdown-heading">ACCOUNT</p>
                    <a class="dropdown-item" href="/dashboard/profile" role="menuitem">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M5 20a7 7 0 0 1 14 0" /></svg>
                        <span>Profile</span>
                    </a>
                    <div class="dropdown-divider" role="separator"></div>
                    <button class="dropdown-item logout-item" type="button" role="menuitem" @onclick="LogOutAsync">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17l5-5-5-5m5 5H3" /><path d="M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6" /></svg>
                        <span>Logout</span>
                    </button>
                </div>
            }
        </div>
    </header>

    <div class="app-body">
        <aside class="app-sidebar">
            <NavMenu />
        </aside>

        <main class="app-main">
            @Body
        </main>
    </div>
</div>


@code
{
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask {get; set;}
    private bool isActive = false;
    private string userName = "User";
    private string? profilePicture = null;



    private void ToggleMenu()
    {
        isActive = !isActive;
    }

     protected override async Task OnParametersSetAsync()
     {
        if(AuthStateTask != null)
        {
            var authState = await AuthStateTask;

            if(authState.User.Identity?.IsAuthenticated == true)
            {
                userName = authState.User.Identity.Name ?? "User";
                profilePicture = authState.User.FindFirst("ProfilePicture")?.Value;
            }
        }
     }


    private async Task LogOutAsync()
    {
        await ((JwtStateProvider)_authState).NotifyUserLoggedOut();

        NavManager.NavigateTo("/login", replace: true);
    }
}
